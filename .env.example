# Copy to .env and fill in:  cp .env.example .env
# Never commit .env (gitignored).

# Local port
PORT=3000

# Auth & Security
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production

# Database (Optional: zero-config local JSON database is used if DATABASE_URL is omitted)
# DATABASE_URL=postgresql://postgres:password@db.supabase.co:5432/postgres

# CORS: your site origin(s) — comma-separated or *
CORS_ORIGIN=*

# Service-account credentials for Google Sheets (Shared Service Account mode)
# Create in Google Cloud Console -> IAM & Admin -> Service Accounts -> Keys -> JSON
GOOGLE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# IMPORTANT — #1 first-setup gotcha:
# Paste private_key AS-IS inside double quotes, keeping literal \n characters.
# Code runs .replace(/\\n/g, '\n') to restore real newlines.
# Example: "-----BEGIN PRIVATE KEY-----\nABC...\n-----END PRIVATE KEY-----\n"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nPASTE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Default Google Sheet (Optional fallback for legacy /api/submit endpoint)
SHEET_ID=PASTE_SHEET_ID_FROM_URL_HERE
SHEET_RANGE=Sheet1!A:D

# SMTP Email Notification (App Password path — see README)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
# 16-char App Password (Google Account → Security → 2FA → App passwords), NOT your login password
SMTP_PASS=xxxx-xxxx-xxxx-xxxx
NOTIFY_TO=you@gmail.com

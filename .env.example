# Copy to .env and fill in:  cp .env.example .env
# Never commit .env (gitignored).

# Local port
PORT=3000

# CORS: lock to your site's origin (fork-friendly — change one value).
# Example: https://persnoxmedia.com
CORS_ORIGIN=http://localhost:3000

# Google Sheet target
SHEET_ID=PASTE_SHEET_ID_FROM_URL_HERE
SHEET_RANGE=Sheet1!A:D

# Service-account credentials (from the JSON key downloaded in Cloud Console)
GOOGLE_CLIENT_EMAIL=PASTE_SERVICE_ACCOUNT_CLIENT_EMAIL_HERE
# IMPORTANT — #1 first-setup gotcha:
# Paste private_key AS-IS inside double quotes, keeping literal \n characters.
# Code runs .replace(/\\n/g, '\n') to restore real newlines.
# Example: "-----BEGIN PRIVATE KEY-----\nABC...\n-----END PRIVATE KEY-----\n"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nPASTE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Gmail SMTP notify (App Password path — see README)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
# 16-char App Password (Google Account → Security → 2FA → App passwords), NOT your login password
SMTP_PASS=xxxx-xxxx-xxxx-xxxx
NOTIFY_TO=you@gmail.com
